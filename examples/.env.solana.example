# Solana Configuration Example
# Copy this file to .env.solana and fill in your values

# Your Solana wallet address (base58) that will receive USDC payments
X402_PAY_TO=YourSolanaWalletAddressHere

# Your Solana private key (NOT your wallet address!)
# Can be in one of these formats:
#   - Base58 encoded 32-byte seed (from wallet export)
#   - JSON array format: [1,2,3,...] (from solana-keygen)
#   - Hex format: 0x... (less common)
# To get your private key: solana-keygen recover
X402_PRIVATE_KEY=YourSolanaPrivateKeyHere

# Network: "solana-devnet" for testnet, "solana" for mainnet
X402_CHAIN=solana-devnet

# Optional: Facilitator's wallet address that will pay transaction fees
# Defaults to x402.org facilitator (CKPKJWNdJEqa81x7CkZ14BVPiY6y16Sxs7owznqtWYp5)
# Only needed if using a custom facilitator
# X402_SOLANA_FEE_PAYER=YourCustomFacilitatorAddress

# Optional: Payment timeout in seconds
# X402_MAX_TIMEOUT_SECONDS=600

# Optional: Custom RPC URLs
# X402_SOLANA_DEVNET_RPC_URL=https://your-solana-devnet-rpc.com
# X402_SOLANA_RPC_URL=https://your-solana-mainnet-rpc.com
